APP_NAME="SSPMS - School Supplies & Purchases Management System"
APP_ENV=local
APP_KEY=base64:5FspMuDEjXShHWrG+NU2+A7Z8amjW5+hqmx2PLdi00M=
APP_DEBUG=true
APP_URL=https://api.sspms.internal
APP_FRONTEND_URL=https://app.sspms.internal
APP_TIMEZONE=Africa/Nairobi

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=dev-mysql
DB_PORT=3306
DB_DATABASE=sspms
DB_USERNAME=root
DB_PASSWORD=Pasbest@2025

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=.sspms.internal
SESSION_SECURE_COOKIE=true

# Redis Configuration
REDIS_HOST=dev-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis
REDIS_PREFIX=sspms_

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=dev-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@sspms.internal"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=app.sspms.internal,localhost,127.0.0.1
SANCTUM_GUARD=api

# JWT Configuration
JWT_SECRET=kPEuJ0TbyU1gUDVA80AmjYAWz0UlPQsVeHvVVLFRZrCujaPAadp3RBgjd7cQNZjR
JWT_TTL=180
JWT_REFRESH_TTL=10080

# CSP Configuration
CSP_ENABLED=true
CSP_REPORT_URI=https://api.sspms.internal/api/csp-report

# File Upload Limits
UPLOAD_MAX_FILESIZE=20M
POST_MAX_SIZE=20M
MEMORY_LIMIT=256M
MAX_EXECUTION_TIME=300
MAX_INPUT_TIME=300

# Application Settings
APP_MAINTENANCE_MODE=false
APP_ENABLE_2FA=true
APP_ENABLE_AUDIT_LOG=true
APP_ENABLE_ACTING_HOD=true
DEFAULT_APPROVAL_DEADLINE_DAYS=7

# Reference Number Formats
REQ_PREFIX=MR
QTN_PREFIX=QTN
TENDER_PREFIX=TND
CONTRACT_PREFIX=CTR
LPO_PREFIX=LPO
LSO_PREFIX=LSO
GRN_PREFIX=GRN
SAN_PREFIX=SAN
PV_PREFIX=PV
REFERENCE_SEPARATOR=-
REFERENCE_YEAR_FORMAT=YYYY
REFERENCE_SEQUENCE_LENGTH=4

# Supplier Settings
SUPPLIER_REGISTRATION_AUTO_APPROVE=false
SUPPLIER_BLACKLIST_ENABLED=true

# Emergency/Fast Track Settings
EMERGENCY_APPROVERS=PRINCIPAL,FINAL_APPROVER,ADMIN
